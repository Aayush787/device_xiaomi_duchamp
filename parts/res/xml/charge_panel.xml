<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/turbo_charge_title">

    <com.android.settingslib.widget.TopIntroPreference
        android:key="turbo_top_intro"
        android:title="@string/turbo_charge_summary"
        android:persistent="false" />

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="turbo_enable"
        android:title="@string/turbo_enable_title"
        android:defaultValue="true" />

    <PreferenceCategory
        android:key="turbo_current_category"
        android:title="@string/turbo_charge_current_pref_title">

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="turbo_mode_18w"
            android:title="@string/turbo_mode_one"
            android:summary="@string/turbo_mode_one_summary"
            android:persistent="false" />

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="turbo_mode_30w"
            android:title="@string/turbo_mode_two"
            android:summary="@string/turbo_mode_two_summary"
            android:persistent="false" />

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="turbo_mode_67w"
            android:title="@string/turbo_mode_three"
            android:summary="@string/turbo_mode_three_summary"
            android:persistent="false" />

    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="turbo_footer_note"
        android:title="@string/turbo_charge_footer_note"
        android:selectable="false" />

</PreferenceScreen>
